rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function newProfile(uid) {
      return request.resource.data.uid == uid &&
        request.resource.data.role == 'student' &&
        request.resource.data.keys().hasOnly([
          'uid', 'role', 'email', 'displayName', 'photoURL', 'agentName',
          'schoolName', 'collegeName', 'isOnline', 'lastSeen',
          'createdAt', 'updatedAt', 'preferences'
        ]);
    }
    function profileUpdate(uid) {
      return resource.data.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'agentName', 'schoolName', 'collegeName',
          'isOnline', 'lastSeen', 'updatedAt', 'preferences'
        ]);
    }
    function privateMessage(uid) {
      return request.resource.data.keys().hasAll([
          'text', 'authorId', 'authorName', 'roomId', 'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'text', 'authorId', 'authorName', 'roomId', 'createdAt',
          'hasAiResponded', 'grounding', 'source'
        ]) &&
        request.resource.data.authorId in [uid, 'gemini-ai'] &&
        request.resource.data.authorName is string &&
        request.resource.data.roomId is string &&
        request.resource.data.roomId.size() <= 100 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 10000 &&
        request.resource.data.createdAt == request.time;
    }
    match /users/{uid} {
      allow get: if owner(uid);
      allow list: if false;
      allow create: if owner(uid) && newProfile(uid);
      allow update: if owner(uid) && profileUpdate(uid);
      allow delete: if false;
      match /messages/{messageId} {
        allow get, list: if owner(uid);
        allow create: if owner(uid) && privateMessage(uid);
        allow update: if owner(uid) &&
          resource.data.authorId == uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['hasAiResponded']) &&
          request.resource.data.hasAiResponded == true;
        allow delete: if owner(uid);
      }
      match /projects/{projectId} {
        allow read, write: if owner(uid);
        match /tasks/{taskId} {
          allow read, write: if owner(uid);
        }
      }
    }
    // Legacy shared collections remain in Firestore until a reviewed migration.
    match /messages/{messageId} { allow read, write: if false; }
    match /projects/{projectId} {
      allow read, write: if false;
      match /tasks/{taskId} { allow read, write: if false; }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
