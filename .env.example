# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SEA.RHO7 AI mode:
# paid-backend = Firebase Functions backend route for production with Secret Manager.
# firebase-free-beta = Firebase AI Logic client SDK route for no-money beta testing.
# local-only = no cloud AI calls.
VITE_SEA_RHO7_AI_MODE="paid-backend"
VITE_SEA_RHO7_FREE_MODEL="gemini-3.1-flash-lite"
# Optional: use this for a hosted Python/Flask backend instead of Firebase Functions.
VITE_SEA_RHO7_AI_ENDPOINT=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
